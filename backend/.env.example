# ════════════════════════════════════════════════════════════════════════════════
# Smart Transportation System - Environment Configuration
# ════════════════════════════════════════════════════════════════════════════════
# Copy file này thành .env và điền giá trị thực tế.
# KHÔNG commit file .env lên git (đã có trong .gitignore).
# ════════════════════════════════════════════════════════════════════════════════

# ──────────────────────────── External Services ────────────────────────────────

# API Gemini (Google Generative AI) - Bắt buộc cho chatbot
GOOGLE_API_KEY=

# ──────────────────────────── Database (PostgreSQL) ────────────────────────────
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_db_password
DATABASE_PORT=5433
DATABASE_HOST=localhost
DATABASE_NAME=transportation_system

# ──────────────────────────── JWT Authentication ───────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your_jwt_secret_key_min_64_chars
ACCESS_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ──────────────────────────── Bots / Notifications ─────────────────────────────
# Telegram Bot Token (từ BotFather) - Optional
BOT_TOKEN=your_telegram_bot_token

# Discord Bot Token - Optional
DISCORD_BOT_TOKEN=your_discord_bot_token

# ──────────────────────────── Runtime / Performance ────────────────────────────
OPENCV_VIDEOIO_PRIORITY_MSMF=0
OPENCV_VIDEOIO_PRIORITY_DSHOW=1
KMP_DUPLICATE_LIB_OK=TRUE

# ──────────────────────────── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
SQL_ECHO=false

# ──────────────────────────── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_NAME=app.log
LOG_FILE_MAX_BYTES=5242880            # 5MB
LOG_FILE_BACKUP_COUNT=5
LOG_TO_CONSOLE=false                  # Set true khi dev local

# ──────────────────────────── Chatbot Memory ───────────────────────────────────
CHAT_MAX_SHORT_TERM_MESSAGES=24
CHAT_LONG_TERM_MEMORY_LIMIT=3
CHAT_MEMORY_DB_URI=postgresql://postgres:your_db_password@localhost:5433/transportation_system

# ──────────────────────────── MinIO (Object Storage) ───────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret
ACCESS_KEY=admin
SECRET_KEY=your_minio_secret
MINIO_SECURE=false                    # true nếu dùng HTTPS
MINIO_BUCKET=road-frames
MINIO_URL_EXPIRY_SECONDS=3600
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SCHEME=http
MINIO_IMAGE_URL_MODE=public           # public | presigned
MINIO_AUTO_SET_PUBLIC_READ=true

# Retention: số ngày giữ lại evidence images (auto cleanup)
MINIO_RETENTION_DAYS=30

# ──────────────────────────── AI Inference ─────────────────────────────────────
# GPU mode: bật/tắt CUDA
GPU_ENABLED=false                     # Set true nếu có GPU NVIDIA
DEVICE=cpu                            # auto-detect: 'cuda' nếu GPU_ENABLED, ngược lại 'cpu'

# Tracker: bytetrack (CPU nhẹ) hoặc botsort (GPU, có ReID)
TRACKER_MODE=bytetrack

# License plate detection model
LP_MODEL_PATH=

# Batch inference: gom frame từ nhiều camera để infer 1 lần (cần GPU)
BATCH_INFERENCE_ENABLED=false
INFERENCE_BATCH_SIZE=5
INFERENCE_MAX_WAIT_MS=40

# ──────────────────────────── CORS / Security ──────────────────────────────────
# Danh sách origins cho phép gọi API (phân cách bằng dấu phẩy)
# Dev: http://localhost:5173,http://localhost:3000
# Prod: https://yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# API Base URL (cho frontend gọi ngược lại)
API_BASE_URL=http://localhost:8000
URL_FRONTEND=http://localhost:5173

# ──────────────────────────── Rate Limiting ────────────────────────────────────
# Số request tối đa / phút cho mỗi IP (áp dụng cho auth endpoints)
RATE_LIMIT_PER_MINUTE=60
# Số WebSocket connections tối đa / IP
WS_MAX_CONNECTIONS_PER_IP=5

# ──────────────────────────── Monitoring / Health ──────────────────────────────
# Bật/tắt Prometheus metrics endpoint (/metrics)
METRICS_ENABLED=true
# Bật/tắt health check chi tiết (/health/detailed)
HEALTH_DETAILED_ENABLED=true

# ──────────────────────────── Violation Detection ──────────────────────────────
# Bật/tắt violation worker
VIOLATION_WORKER_ENABLED=true
# Queue size tối đa (drop cũ khi đầy)
VIOLATION_QUEUE_MAX_SIZE=1000
# Tốc độ tối đa cho phép (km/h) - dùng làm default nếu không có SPEED_LIMITS
DEFAULT_SPEED_LIMIT=50

# ──────────────────────────── Feature Flags ────────────────────────────────────
# Bật/tắt ANPR (license plate recognition) - cần GPU + EasyOCR
ANPR_ENABLED=false
# Bật/tắt Discord alerts khi có vi phạm
DISCORD_ALERTS_ENABLED=false